@model NewLoco.Web.ViewModels.ShiftWorks.CreateShiftWorkViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using NewLoco.GCommon.Enums
@{
    ViewData["Title"] = "Create Shift";
    }

<h2 class="h5 mb-3">@ViewData["Title"]</h2>

@if (TempData["Error"] is string e && !string.IsNullOrWhiteSpace(e))
    {
    <div class="alert alert-danger py-2">@e</div>
    }

<div class="mx-auto p-3 border rounded shadow-sm bg-white" style="max-width:520px;">
    <form asp-action="Create" method="post" novalidate>
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-2">
            <label asp-for="LocomotiveId" class="form-label"></label>
                @{
                var locoList = ViewBag.Locomotives as IEnumerable<SelectListItem>;
                }
            @if (locoList != null && locoList.Any())
                {
                <select asp-for="LocomotiveId" class="form-select" asp-items="locoList" id="LocomotiveId">
                    <option value="" disabled selected>-- choose --</option>
                </select>
                }
            else
                {
                <input asp-for="LocomotiveId" type="number" class="form-control" id="LocomotiveId" />
                }
            <span asp-validation-for="LocomotiveId" class="text-danger"></span>
        </div>

        <div class="mb-2">
            <label asp-for="Date" class="form-label"></label>
            <input asp-for="Date" class="form-control" type="date" asp-format="{0:yyyy-MM-dd}" id="Date" />
            <span asp-validation-for="Date" class="text-danger"></span>
        </div>

        <div class="mb-2">
            <label asp-for="Shift" class="form-label"></label>
            <select asp-for="Shift" class="form-select" id="Shift">
                @foreach (var s in Enum.GetValues(typeof(Shift)))
                    {
                    <option value="@((int)s)">@s</option>
                    }
            </select>
            <span asp-validation-for="Shift" class="text-danger"></span>
        </div>

        <div class="row g-2">
            <div class="col-4">
                <label asp-for="InitialValue" class="form-label"></label>
                <input asp-for="InitialValue" class="form-control" type="number" step="0.01" inputmode="decimal" id="InitialValue" />
                <span asp-validation-for="InitialValue" class="text-danger"></span>
            </div>
            <div class="col-4">
                <label asp-for="FinalValue" class="form-label"></label>
                <input asp-for="FinalValue" class="form-control" type="number" step="0.01" inputmode="decimal" id="FinalValue"
                       data-val="true" data-val-finalnotlessthaninitial="Final must be ≥ Initial" />
                <span asp-validation-for="FinalValue" class="text-danger"></span>
            </div>
            <div class="col-4">
                <label asp-for="Amount" class="form-label"></label>
                <input asp-for="Amount" class="form-control" type="number" step="0.01" inputmode="decimal" id="Amount"
                       readonly data-val="true" data-val-amountmatches="Amount must equal Final - Initial" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-2 mt-2">
            <label asp-for="OperatorName" class="form-label"></label>
            <input asp-for="OperatorName" class="form-control" />
            <span asp-validation-for="OperatorName" class="text-danger"></span>
        </div>

        <div class="mb-2">
            <label asp-for="Note" class="form-label"></label>
            <textarea asp-for="Note" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Note" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2 mt-2">
            <button type="submit" class="btn btn-primary btn-sm">Save</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancel</a>
        </div>
    </form>
</div>

    @section Scripts {
    <partial name="~/Areas/Identity/Pages/_ValidationScriptsPartial.cshtml" />
    <script>
        function toNumber(v){ if(v===undefined||v===null) return 0; if(typeof v!=='string') v=String(v); v=v.replace(',', '.').trim(); var n=parseFloat(v); return isNaN(n)?0:n; }
        function fmt(x){ return (Math.round(x*100)/100).toFixed(2); }
        function upd(){
            var init = toNumber(document.getElementById('InitialValue')?.value);
            var fin  = toNumber(document.getElementById('FinalValue')?.value);
            var a = document.getElementById('Amount');
            if(a) a.value = fmt(fin - init);
        }
        document.addEventListener('DOMContentLoaded', function(){
            var i = document.getElementById('InitialValue');
            var f = document.getElementById('FinalValue');
            if(i) i.addEventListener('input', function(){ upd(); $(this).valid(); $('#FinalValue').valid(); $('#Amount').valid(); });
            if(f) f.addEventListener('input', function(){ upd(); $(this).valid(); $('#InitialValue').valid(); $('#Amount').valid(); });
            upd();
        });

        $.validator.addMethod('finalnotlessthaninitial', function (value, element, params) {
            var init = toNumber($('#InitialValue').val());
            var fin = toNumber($('#FinalValue').val());
            return fin >= init;
        });
        $.validator.unobtrusive.adapters.addBool('finalnotlessthaninitial');

        $.validator.addMethod('amountmatches', function (value, element, params) {
            var init = toNumber($('#InitialValue').val());
            var fin = toNumber($('#FinalValue').val());
            var amount = toNumber($('#Amount').val());
            return Math.abs((fin - init) - amount) < 0.005;
        });
        $.validator.unobtrusive.adapters.addBool('amountmatches');
    </script>
    }