@model NewLoco.Web.ViewModels.Axles.AxleMeasurementCardDetailsViewModel
@using NewLoco.Web.Auth

<h4>Axle Measurements for @Model.LocomotiveNumber (@Model.DocumentNumber)</h4>

@if (!Model.Axles.Any())
{
    <p>No axle measurements available.</p>
}
else
{
    @if (User.HasClaim("permission", Perm.Repairs.Edit))
    {
        <form asp-action="EditAxles" method="post">
            <input type="hidden" name="CardId" value="@Model.Id" />

            <table class="table table-striped table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Axle</th>
                        <th>Sd Left</th>
                        <th>Sd Right</th>
                        <th>Sh Left</th>
                        <th>Sh Right</th>
                        <th>qR Left</th>
                        <th>qR Right</th>
                        <th>Ar</th>
                        <th>Sr</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Axles.Count; i++)
                    {
                        <tr>
                            <td>@Model.Axles[i].AxleNumber</td>
                            <td>
                                <input type="number" step="0.01" class="form-control form-control-sm"
                                       name="Axles[@i].Sd_Left" value="@Model.Axles[i].Sd_Left" />
                            </td>
                            <td>
                                <input type="number" step="0.01" class="form-control form-control-sm"
                                       name="Axles[@i].Sd_Right" value="@Model.Axles[i].Sd_Right" />
                            </td>
                            <td>
                                <input type="number" step="0.01" class="form-control form-control-sm"
                                       name="Axles[@i].Sh_Left" value="@Model.Axles[i].Sh_Left" />
                            </td>
                            <td>
                                <input type="number" step="0.01" class="form-control form-control-sm"
                                       name="Axles[@i].Sh_Right" value="@Model.Axles[i].Sh_Right" />
                            </td>
                            <td>
                                <input type="number" step="0.01" class="form-control form-control-sm"
                                       name="Axles[@i].QR_Left" value="@Model.Axles[i].QR_Left" />
                            </td>
                            <td>
                                <input type="number" step="0.01" class="form-control form-control-sm"
                                       name="Axles[@i].QR_Right" value="@Model.Axles[i].QR_Right" />
                            </td>
                            <td>
                                <input type="number" step="0.01" class="form-control form-control-sm"
                                       name="Axles[@i].Ar" value="@Model.Axles[i].Ar" />
                            </td>
                            <td>
                                <input type="number" step="0.01" class="form-control form-control-sm"
                                       name="Axles[@i].Sr" value="@Model.Axles[i].Sr" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="mt-3">
                <button type="submit" class="btn btn-success me-2">Save Changes</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    }
    else
    {
       
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Axle</th>
                    <th>Sd Left</th>
                    <th>Sd Right</th>
                    <th>Sh Left</th>
                    <th>Sh Right</th>
                    <th>qR Left</th>
                    <th>qR Right</th>
                    <th>Ar</th>
                    <th>Sr</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Axles)
                {
                    <tr>
                        <td>@a.AxleNumber</td>
                        <td>@a.Sd_Left</td>
                        <td>@a.Sd_Right</td>
                        <td>@a.Sh_Left</td>
                        <td>@a.Sh_Right</td>
                        <td>@a.QR_Left</td>
                        <td>@a.QR_Right</td>
                        <td>@a.Ar</td>
                        <td>@a.Sr</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mt-3">
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    }
}