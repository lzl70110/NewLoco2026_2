@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using NewLoco.Data.Models
@using NewLoco.Web.Auth
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<ApplicationRole> RoleManager
@inject IAuthorizationService AuthorizationService

@{
    var title = ViewData["Title"] as string ?? "NewLoco";
    var userName = User.Identity?.IsAuthenticated == true ? (User.Identity?.Name ?? "User") : "Guest";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>

    <!-- Vendor CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- App CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site-layout.css.css" asp-append-version="true" /> @* uses existing filename *@

    @RenderSection("Styles", required: false)

    <style>
        /* Active state for left menu buttons */
        .btn-sub-active {
            border-color: var(--bs-primary);
            background-color: rgba(13,110,253,.08);
            color: #0d6efd;
            font-weight: 600;
        }
        /* Compact sidebar buttons */
        .sidebar-btn {
            display: block;
            width: 100%;
            text-align: left;
            margin-bottom: .5rem;
        }

        .sidebar-section-title {
            font-weight: 600;
            color: #6c757d;
            margin: .35rem 0 .25rem 0;
        }
        /* Accordion visuals inside sidebar */
        .accordion-button {
            background: transparent;
            border-radius: .375rem;
            padding: .5rem .6rem;
        }

            .accordion-button:not(.collapsed) {
                background: #e7f1ff;
                box-shadow: none;
            }

        .accordion-body a.btn {
            margin-bottom: .45rem;
        }
    </style>
</head>
<body>
    <!-- Top navbar -->
    <header class="navbar navbar-dark bg-dark px-3">
        <!-- Brand to Home -->
        <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Home</a>

        <div class="ms-auto d-flex align-items-center gap-2">
            @if (SignInManager.IsSignedIn(User!))
            {
                // Resolve current user + roles
                var user = await UserManager.GetUserAsync(User!);
                var roleNames = user is null ? Array.Empty<string>() : await UserManager.GetRolesAsync(user);

                // Helper for role visuals
                (string Css, string Icon) RoleVisual(string rn) => rn switch
                {
                    "SysAdmin" => ("bg-danger", "bi-shield-lock-fill"),
                    "Operator" => ("bg-primary", "bi-gear-fill"),
                    "Viewer" => ("bg-secondary", "bi-eye-fill"),
                    _ => ("bg-dark", "bi-person-badge-fill")
                };

                // Build role badges
                var badges = new List<(string Label, string Css, string Icon)>();
                foreach (var rn in roleNames)
                {
                    var roleObj = await RoleManager.FindByNameAsync(rn);
                    var label = roleObj?.Label ?? rn;
                    var (css, icon) = RoleVisual(rn);
                    badges.Add((label, css, icon));
                }

                <!-- Badges + Email + Logout -->
                <div class="d-flex align-items-center gap-2">
                    @if (badges.Count == 0)
                    {
                        <span class="badge rounded-pill text-bg-light border" title="No role assigned">No role</span>
                    }
                    else
                    {
                        foreach (var b in badges)
                        {
                            <span class="badge rounded-pill text-white @b.Css" title="Role">
                                <i class="bi @b.Icon me-1" aria-hidden="true"></i>@b.Label
                            </span>
                        }
                    }

                    <a class="nav-link text-white px-2"
                       asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage account">
                        @user?.Email
                    </a>

                    <form method="post"
                          asp-area="Identity"
                          asp-page="/Account/Logout"
                          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                          class="m-0">
                        <button type="submit" class="btn btn-sm btn-outline-light">Logout</button>
                    </form>
                </div>
            }
            else
            {
                <span class="text-white me-2">@userName</span>
                <a asp-area="Identity" asp-page="/Account/Login"
                   class="btn btn-sm btn-outline-light">Login</a>
            }
        </div>
    </header>

    <div class="d-flex" style="height: calc(100vh - 56px);">
        <!-- Sidebar -->
        <nav class="bg-light p-3" style="width:20%; overflow-y:auto;">
            @await Html.PartialAsync("_Sidebar") <!-- Sidebar is split into its own partial -->
        </nav>

        <!-- Main content -->
        <main class="flex-grow-1 p-3" style="overflow:auto;">
            @RenderBody()
        </main>
    </div>

    <!-- Vendor JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>