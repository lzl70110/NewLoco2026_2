@model IEnumerable<NewLoco.Web.ViewModels.Axles.AxleMeasurementCardListViewModel>
@using NewLoco.Web.Auth

@{
    ViewData["Title"] = "Axle Measurement Cards";
}

<h2 class="mb-4">Axle Measurement Cards</h2>

@if (User.HasClaim("permission", Perm.Repairs.Create))
{
    <div class="mb-3 text-end">
        <a asp-controller="AxleMeasurements"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> New Card
        </a>
    </div>
}

<table class="table table-striped table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th>Document</th>
            <th>Locomotive</th>
            <th>Date</th>
         @*    <th>Axles</th> *@
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="5" class="text-center">No measurement cards found.</td>
            </tr>
        }
        else
        {
            @foreach (var card in Model)
            {
                <tr>
                    <td>@card.DocumentNumber</td>
                    <td>@card.LocomotiveNumber</td>
                    <td>@card.MeasurementDate.ToString("dd.MM.yyyy")</td>
                @*     <td>@card.AxleCount</td> *@
                    <td class="text-end">
                        <a asp-controller="AxleMeasurements"
                           asp-action="Details"
                           asp-route-id="@card.Id"
                           class="btn btn-sm btn-outline-primary me-1">
                            Details
                        </a>

                        @if (User.HasClaim("permission", Perm.Repairs.Edit))
                        {
                            <a asp-controller="AxleMeasurements"
                               asp-action="Edit"
                               asp-route-id="@card.Id"
                               class="btn btn-sm btn-outline-warning me-1">
                                Edit
                            </a>
                        }

                        @if (User.HasClaim("permission", Perm.Repairs.Delete))
                        {
                            <a asp-controller="AxleMeasurements"
                               asp-action="Delete"
                               asp-route-id="@card.Id"
                               class="btn btn-sm btn-outline-danger">
                                Delete
                            </a>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>