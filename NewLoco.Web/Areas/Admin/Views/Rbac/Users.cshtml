@model NewLoco.Web.Areas.Admin.Models.UsersWithRolesPageViewModel

@{
    ViewData["Title"] = "Users";
    Layout = "/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2 class="mt-3">Users</h2>

<!-- Messages -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model == null || Model.Users == null || !Model.Users.Any())
{
    <p>No users found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>User</th>
                <th>Email</th>
                <th>Roles</th>
                <th>Add Role</th>
                <th>Remove Role</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model.Users)
            {
                <tr>
                    <td>@u.UserName</td>
                    <td>@u.Email</td>

                    <!-- Roles -->
                    <td>
                        @if (u.Roles != null && u.Roles.Any())
                        {
                            @string.Join(", ", u.Roles)
                        }
                        else
                        {
                            <span class="text-muted">No roles</span>
                        }
                    </td>

                    <!-- ADD ROLE -->
                    <td>
                        <form asp-area="Admin"
                              asp-controller="Rbac"
                              asp-action="AddUserToRole"
                              method="post"
                              class="d-flex">

                            @Html.AntiForgeryToken()

                            <input type="hidden" name="EmailOrUserName" value="@u.UserName" />

                            <select name="RoleName" class="form-select form-select-sm me-1">
                                @foreach (var role in Model.AllRoles.Except(u.Roles ?? Array.Empty<string>()))
                                {
                                    <option value="@role">@role</option>
                                }
                            </select>

                            <button type="submit" class="btn btn-sm btn-success">
                                Add
                            </button>
                        </form>
                    </td>

                    <!-- REMOVE ROLE -->
                    <td>
                        @if (u.Roles != null && u.Roles.Any())
                        {
                            <form asp-area="Admin"
                                  asp-controller="Rbac"
                                  asp-action="RemoveUserFromRole"
                                  method="post"
                                  class="d-flex">

                                @Html.AntiForgeryToken()

                                <input type="hidden" name="EmailOrUserName" value="@u.UserName" />

                                <select name="RoleName" class="form-select form-select-sm me-1">
                                    @foreach (var role in u.Roles)
                                    {
                                        <option value="@role">@role</option>
                                    }
                                </select>

                                <button type="submit" class="btn btn-sm btn-danger">
                                    Remove
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}