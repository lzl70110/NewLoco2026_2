@model NewLoco.Web.ViewModels.Fuels.FuelAllViewModel

@{
    ViewData["Title"] = "Delete Fuel Record";
}

<h2>Delete Fuel Record - @Model.LocomotiveNumber (@Model.Date.ToString("dd.MM.yyyy"))</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this fuel record?
</div>

<table class="table table-bordered">
    <tr><th>Initial Fuel</th><td>@Model.InitialFuel</td></tr>
    <tr><th>Final Fuel</th><td>@Model.FinalFuel</td></tr>
    <tr><th>Consumption</th><td>@Model.Consumption</td></tr>
    <tr><th>Refueled</th><td>@Model.Refueled</td></tr>
    <tr><th>Note</th><td>@(string.IsNullOrWhiteSpace(Model.Note) ? "-" : Model.Note)</td></tr>
</table>

<form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>