@using Microsoft.AspNetCore.Identity
@using NewLoco.Data.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var title = ViewData["Title"] as string ?? "NewLoco";
    var userName = User.Identity?.IsAuthenticated == true
        ? (User.Identity?.Name ?? "User")
        : "Guest";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/site-layout.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <header class="navbar navbar-dark bg-dark px-3">
        <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Index</a>

        <div class="ms-auto d-flex align-items-center">
            <span class="text-white me-3">@userName</span>

            @if (SignInManager.IsSignedIn(User))
            {
                <form method="post"
                      asp-area="Identity"
                      asp-page="/Account/Logout"
                      asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                      class="m-0">
                    <button type="submit" class="btn btn-sm btn-outline-light">Logout</button>
                </form>
            }
            else
            {
                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-sm btn-outline-light">Login</a>
            }
        </div>
    </header>

    <div class="app-layout d-flex" style="height: calc(100vh - 56px);">
        <!-- Sidebar -->
        <nav class="ultra-sidebar bg-dark p-3" style="width:20%;">
            @* ONLY render active section *@
            @if (currentArea == "Admin" && currentController == "Users")
            {
                <span class="text-white fw-bold d-block mb-2">Users</span>
                <a asp-area="Admin" asp-controller="Users" asp-action="Index"
                   class="btn btn-outline-light w-100 text-start mb-2 active">
                    <i class="bi bi-people"></i> All Users
                </a>
                <a asp-area="Admin" asp-controller="Users" asp-action="Create"
                   class="btn btn-outline-light w-100 text-start mb-2">
                    <i class="bi bi-person-plus"></i> Create User
                </a>
            }
            else if (currentArea == "Admin" && currentController == "Roles")
            {
                <span class="text-white fw-bold d-block mb-2">Roles</span>
                <a asp-area="Admin" asp-controller="Roles" asp-action="Index"
                   class="btn btn-outline-light w-100 text-start mb-2 active">
                    <i class="bi bi-shield-lock"></i> All Roles
                </a>
                <a asp-area="Admin" asp-controller="Roles" asp-action="Create"
                   class="btn btn-outline-light w-100 text-start mb-2">
                    <i class="bi bi-plus-circle"></i> Create Role
                </a>
            }
            else if (currentController == "Fuels")
            {
                <span class="text-white fw-bold d-block mb-2">Fuel</span>
                <a asp-controller="Fuels" asp-action="Index"
                   class="btn btn-outline-light w-100 text-start mb-2 active">
                    <i class="bi bi-list-ul"></i> All Fuels
                </a>
                <a asp-controller="Fuels" asp-action="Create"
                   class="btn btn-outline-light w-100 text-start mb-2">
                    <i class="bi bi-plus-circle"></i> New Input
                </a>
                <a asp-controller="Fuels" asp-action="FuelReport"
                   class="btn btn-outline-light w-100 text-start mb-2">
                    <i class="bi bi-graph-up-arrow"></i> Fuel Report
                </a>
            }
            else if (currentController == "ShiftWork")
            {
                <span class="text-white fw-bold d-block mb-2">Shift Work</span>
                <a asp-controller="ShiftWork" asp-action="Index"
                   class="btn btn-outline-light w-100 text-start mb-2 active">
                    <i class="bi bi-list-ul"></i> All Records
                </a>
                <a asp-controller="ShiftWork" asp-action="Create"
                   class="btn btn-outline-light w-100 text-start mb-2">
                    <i class="bi bi-plus-circle"></i> New Entry
                </a>
            }
            else
            {
                  
                <a asp-controller="Home" asp-action="Index" asp-area=" "
                   class="btn btn-outline-light w-100 text-start mb-2 @(currentController == "Home" ? "active" : "")">
                    <i class="bi bi-house"></i> Home
                </a>
            }
        </nav>

        <!-- Main content -->
        <main class="main-content flex-grow-1 p-3" style="overflow:auto;">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>