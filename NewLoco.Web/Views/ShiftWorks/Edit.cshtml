@model NewLoco.Web.ViewModels.ShiftWorks.EditShiftWorkViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using NewLoco.GCommon.Enums
@{
    ViewData["Title"] = "Edit Shift";
    }

<h2 class="h5 mb-3">@ViewData["Title"]</h2>

@if (TempData["Error"] is string e && !string.IsNullOrWhiteSpace(e))
    {
    <div class="alert alert-danger py-2">@e</div>
    }

<div class="mx-auto p-3 border rounded shadow-sm bg-white" style="max-width:520px;">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-2">
            <label class="form-label">Locomotive</label>
                @{
                var locoList = ViewBag.Locomotives as IEnumerable<SelectListItem>;
                }
            @if (locoList != null && locoList.Any())
                {
                <select asp-for="LocomotiveId" class="form-select" asp-items="locoList">
                    <option value="" disabled>-- choose --</option>
                </select>
                }
            else
                {
                <input asp-for="LocomotiveId" type="number" class="form-control" />
                }
            <span asp-validation-for="LocomotiveId" class="text-danger"></span>
        </div>

        <div class="mb-2">
            <label asp-for="Date" class="form-label"></label>
            <input asp-for="Date" class="form-control" type="date" asp-format="{0:yyyy-MM-dd}" />
            <span asp-validation-for="Date" class="text-danger"></span>
        </div>

        <div class="mb-2">
            <label asp-for="Shift" class="form-label"></label>
            <select asp-for="Shift" class="form-select">
                @foreach (var s in Enum.GetValues(typeof(Shift)))
                    {
                    <option value="@((int)s)">@s</option>
                    }
            </select>
            <span asp-validation-for="Shift" class="text-danger"></span>
        </div>

        <div class="row g-2">
            <div class="col-4">
                <label asp-for="StartValue" class="form-label"></label>
                <input asp-for="StartValue" class="form-control" type="number" step="0.01" inputmode="decimal" id="InitialValue" />
                <span asp-validation-for="StartValue" class="text-danger"></span>
            </div>
            <div class="col-4">
                <label asp-for="EndValue" class="form-label"></label>
                <input asp-for="EndValue" class="form-control" type="number" step="0.01" inputmode="decimal" id="FinalValue" />
                <span asp-validation-for="EndValue" class="text-danger"></span>
            </div>
            <div class="col-4">
                <label asp-for=" EndValue" class="form-label"></label>
                <input asp-for="EndValue" class="form-control" type="number" step="0.01" inputmode="decimal" id="Amount" readonly />
                <span asp-validation-for="EndValue" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-2 mt-2">
            <label asp-for="Note" class="form-label"></label>
            <textarea asp-for="Note" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Note" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2 mt-2">
            <button type="submit" class="btn btn-primary btn-sm">Save</button>
            <a asp-action="Index" class="btn btn-secondary btn-sm">Cancel</a>
        </div>
    </form>
</div>

    @section Scripts {
    <partial name="~/Areas/Identity/Pages/_ValidationScriptsPartial.cshtml" />
    <script>
        function toNumber(v) {
            if (v === undefined || v === null) return 0;
            if (typeof v !== 'string') v = String(v);
            v = v.replace(',', '.').trim();
            var n = parseFloat(v);
            return isNaN(n) ? 0 : n;
        }
        function fmt(x) { return (Math.round(x * 100) / 100).toFixed(2); }

        function upd() {
            var init = toNumber(document.getElementById('InitialValue')?.value);
            var fin = toNumber(document.getElementById('FinalValue')?.value);
            var a = document.getElementById('Amount');
            if (a) a.value = fmt(fin - init);
        }

        document.addEventListener('DOMContentLoaded', function () {
            var i = document.getElementById('InitialValue');
            var f = document.getElementById('FinalValue');
            if (i) i.addEventListener('input', upd);
            if (f) f.addEventListener('input', upd);
            upd();
        });
    </script>
    }
