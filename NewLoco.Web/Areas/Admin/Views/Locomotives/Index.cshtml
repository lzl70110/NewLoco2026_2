@using Microsoft.AspNetCore.Mvc.Rendering
@model IEnumerable<NewLoco.Web.ViewModels.Locomotives.LocomotiveNumberViewModel>

@{
    ViewData["Title"] = "Locomotives";

    var currentFilter = (string?)ViewData["CurrentFilter"] ?? "all";

    var filterItems = new List<SelectListItem>
    {
        new SelectListItem { Text = "All",     Value = "all",     Selected = currentFilter == "all" },
        new SelectListItem { Text = "Active",  Value = "active",  Selected = currentFilter == "active" },
        new SelectListItem { Text = "Deleted", Value = "deleted", Selected = currentFilter == "deleted" }
    };
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="mb-0">Locomotives</h2>

    <div class="d-flex align-items-center gap-2">
        <form method="get" class="d-flex align-items-center gap-2">
            <label class="form-label mb-0">Filter:</label>
            @Html.DropDownList("filter", filterItems, new { @class = "form-select form-select-sm", onchange = "this.form.submit()" })
        </form>

        <a asp-action="Create" asp-route-filter="@currentFilter" class="btn btn-primary btn-sm">Add New Locomotive</a>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover table-loco w-auto">
        <thead class="table-dark">
            <tr>
                <th>Number</th>
                <th>Note</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var loco in Model)
                {
                    <tr>
                        <td class="align-middle">@loco.Number</td>
                        <td class="align-middle">@loco.Note</td>
                        <td class="align-middle">
                            @if (loco.IsDeleted)
                            {
                                <span class="badge bg-danger">Deleted</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </td>
                        <td class="text-end align-middle">
                            <a asp-action="Details" asp-route-id="@loco.Id" asp-route-filter="@currentFilter" class="btn btn-sm btn-primary">Details</a>

                            @if (loco.IsDeleted)
                            {
                                <form method="post" asp-action="Undelete" asp-area="Admin" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@loco.Id" />
                                    <input type="hidden" name="filter" value="@currentFilter" />
                                    <button type="submit" class="btn btn-sm btn-success">Undelete</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-action="Delete" asp-area="Admin" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@loco.Id" />
                                    <input type="hidden" name="filter" value="@currentFilter" />
                                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-muted">No locomotives found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>