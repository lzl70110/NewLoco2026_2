@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    var title = ViewData["Title"] as string ?? "NewLoco";
    var userName = User.Identity?.IsAuthenticated == true ? (User.Identity?.Name ?? "User") : "Guest";

    // route context (used to open/mark active sections)
    var currentController = (ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty);
    var currentAction = (ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty);

    bool isFuels = currentController.Equals("Fuels", StringComparison.OrdinalIgnoreCase);
    bool isShiftWorks = currentController.Equals("ShiftWorks", StringComparison.OrdinalIgnoreCase);

    // Admin section considered open on these controllers
    bool isAdminSection =
        currentController.Equals("Locomotives", StringComparison.OrdinalIgnoreCase) ||
        currentController.Equals("PublicLocomotives", StringComparison.OrdinalIgnoreCase) || // keep per your current logic
        currentController.Equals("Calendar", StringComparison.OrdinalIgnoreCase) ||
        currentController.Equals("Calculator", StringComparison.OrdinalIgnoreCase);

    bool adminOpen = isAdminSection; // keep Admin submenu expanded on Admin pages
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>

    <!-- Vendor CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" crossorigin="anonymous" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
          crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- App CSS -->
    <link rel="stylesheet" href="~/css/site-layout.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)

    <style>
        /* active submenu visual */
        .btn-sub-active {
            border-color: var(--bs-primary);
            background-color: rgba(13,110,253,.08);
            color: #0d6efd;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <!-- Top navbar -->
    <header class="navbar navbar-dark bg-dark px-3">
        <!-- brand to Home -->
        <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Home</a>

        <div class="ms-auto d-flex align-items-center">
            <span class="text-white me-3">@userName</span>

            @if (SignInManager.IsSignedIn(User))
            {
                <!-- Logout to Identity Razor Page -->
                <form method="post"
                      asp-area="Identity"
                      asp-page="/Account/Logout"
                      asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                      class="m-0">
                    <button type="submit" class="btn btn-sm btn-outline-light">Logout</button>
                </form>
            }
            else
            {
                <a asp-area="Identity" asp-page="/Account/Login"
                   class="btn btn-sm btn-outline-light">Login</a>
            }
        </div>
    </header>

    <div class="d-flex" style="height: calc(100vh - 56px);">
        <!-- Sidebar -->
        <nav class="bg-light p-3" style="width:20%; overflow-y:auto;">

            <!-- ADMIN (collapsible) -->
            <button class="btn @(adminOpen ? "btn-secondary" : "btn-outline-secondary") w-100 text-start mb-2"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#adminSubmenu"
                    aria-expanded="@(adminOpen.ToString().ToLower())"
                    aria-controls="adminSubmenu">
                <i class="bi bi-gear-fill me-1"></i> Admin
                <i class="bi bi-caret-down-fill float-end"></i>
            </button>

            <div class="collapse @(adminOpen ? "show" : "") ms-2" id="adminSubmenu">
                <!-- Our locomotives (signed-in → Admin area, else → public list) -->
                @if (SignInManager.IsSignedIn(User))
                {
                    <a asp-area="Admin" asp-controller="Locomotives" asp-action="Index"
                       class="btn @(currentController.Equals("Locomotives", StringComparison.OrdinalIgnoreCase) ? "btn-sub-active" : "btn-outline-secondary") w-100 text-start mb-2">
                        <i class="fas fa-train me-1"></i> Our locomotives
                    </a>
                }
                else
                {
                    <a asp-area="" asp-controller="PublicLocomotives" asp-action="Index"
                       class="btn @(currentController.Equals("PublicLocomotives", StringComparison.OrdinalIgnoreCase) ? "btn-sub-active" : "btn-outline-secondary") w-100 text-start mb-2">
                        <i class="fas fa-train me-1"></i> Our locomotives
                    </a>
                }

                <!-- Calendar -->
                <a asp-area="" asp-controller="Calendar" asp-action="Index"
                   class="btn @(currentController.Equals("Calendar", StringComparison.OrdinalIgnoreCase) ? "btn-sub-active" : "btn-outline-secondary") w-100 text-start mb-2">
                    <i class="bi bi-calendar3 me-1"></i> Calendar
                </a>

                <!-- Calculator -->
                <a asp-area="" asp-controller="Calculator" asp-action="Index"
                   class="btn @(currentController.Equals("Calculator", StringComparison.OrdinalIgnoreCase) ? "btn-sub-active" : "btn-outline-secondary") w-100 text-start mb-2">
                    <i class="bi bi-calculator me-1"></i> Calculator
                </a>
            </div>

            @if (SignInManager.IsSignedIn(User))
            {
                <!-- Fuel -->
                <button class="btn @(isFuels ? "btn-warning" : "btn-outline-warning") w-100 text-start mb-2"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#fuelSubmenu"
                        aria-expanded="@(isFuels.ToString().ToLower())"
                        aria-controls="fuelSubmenu">
                    <i class="bi bi-fuel-pump"></i> Fuel
                    <i class="bi bi-caret-down-fill float-end"></i>
                </button>

                <div class="collapse @(isFuels ? "show" : "") ms-2" id="fuelSubmenu">
                    <!-- List (Index) -->
                    <a asp-area="" asp-controller="Fuels" asp-action="Index"
                       class="btn @(currentController.Equals("Fuels", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Index", StringComparison.OrdinalIgnoreCase) ? "btn-sub-active" : "btn-outline-secondary") w-100 text-start mb-2">
                        <i class="bi bi-table"></i> List
                    </a>

                    <!-- New Input (Create) -->
                    <a asp-area="" asp-controller="Fuels" asp-action="Create"
                       class="btn @(currentController.Equals("Fuels", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Create", StringComparison.OrdinalIgnoreCase) ? "btn-sub-active" : "btn-outline-secondary") w-100 text-start mb-2">
                        <i class="bi bi-plus-circle"></i> New Input
                    </a>

                    <!-- Fuel Report (wide) -->
                    <a asp-area="" asp-controller="Fuels" asp-action="FuelReport"
                       class="btn @(currentController.Equals("Fuels", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("FuelReport", StringComparison.OrdinalIgnoreCase) ? "btn-sub-active" : "btn-outline-secondary") w-100 text-start mb-2">
                        <i class="bi bi-graph-up-arrow"></i> Fuel Report
                    </a>
                </div>

                <!-- ShiftWorks -->
                <button class="btn @(isShiftWorks ? "btn-info" : "btn-outline-info") w-100 text-start mb-2"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#shiftSubmenu"
                        aria-expanded="@(isShiftWorks.ToString().ToLower())"
                        aria-controls="shiftSubmenu">
                    <i class="bi bi-calendar-check"></i> Shift Work
                    <i class="bi bi-caret-down-fill float-end"></i>
                </button>

                <div class="collapse @(isShiftWorks ? "show" : "") ms-2" id="shiftSubmenu">
                    <a asp-area="" asp-controller="ShiftWorks" asp-action="Create"
                       class="btn @(currentController.Equals("ShiftWorks", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Create", StringComparison.OrdinalIgnoreCase) ? "btn-sub-active" : "btn-outline-secondary") w-100 text-start mb-2">
                        <i class="bi bi-plus-circle"></i> New Shift
                    </a>

                    <a asp-area="" asp-controller="ShiftWorks" asp-action="Index"
                       class="btn @(currentController.Equals("ShiftWorks", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Index", StringComparison.OrdinalIgnoreCase) ? "btn-sub-active" : "btn-outline-secondary") w-100 text-start mb-2">
                        <i class="bi bi-table"></i> Shift Overview
                    </a>
                </div>
            }
        </nav>

        <!-- Main content -->
        <main class="flex-grow-1 p-3" style="overflow:auto;">
            @RenderBody()
        </main>
    </div>

    <!-- Vendor JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            crossorigin="anonymous"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>