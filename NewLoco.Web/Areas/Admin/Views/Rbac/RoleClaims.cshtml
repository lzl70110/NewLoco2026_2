@model NewLoco.Web.Areas.Admin.Models.RoleClaimsViewModel
@using GCommon

@{
    ViewData["Title"] = "Role Claims";
}

<h2 class="mb-3">Manage Permissions for role: @Model.RoleName</h2>

<form asp-area="Admin" asp-controller="Rbac" asp-action="RoleClaims" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="RoleName" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="mb-3">
        <h5>Available permissions</h5>

        @foreach (var perm in Model.AvailablePermissions)
        {
            var isChecked = Model.SelectedPermissions.Contains(perm);

            <div class="form-check">
                <input class="form-check-input"
                       type="checkbox"
                       name="Selected"
                       value="@perm"
                       id="perm_@perm"
                       @(isChecked ? "checked" : "") />

                <label class="form-check-label" for="perm_@perm">@perm</label>
            </div>
        }
    </div>

    <div class="d-flex gap-2 mt-3">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-area="Admin" asp-controller="Rbac" asp-action="Roles" class="btn btn-secondary">Back</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}