@model NewLoco.Web.ViewModels.Fuels.FuelAllViewModel

@{
    ViewData["Title"] = "Fuel Details";
}

<h2 class="h5 mb-3">@ViewData["Title"]</h2>

<dl class="row">
    <dt class="col-sm-3">Locomotive</dt>
    <dd class="col-sm-9">
        <a asp-area="Admin" asp-controller="Locomotives" asp-action="Details" asp-route-id="@Model.LocomotiveId">@Model.LocomotiveNumber</a>
    </dd>

    <dt class="col-sm-3">Date</dt>
    <dd class="col-sm-9">@Model.Date.ToString("yyyy-MM-dd")</dd>

    <dt class="col-sm-3">Initial Fuel</dt>
    <dd class="col-sm-9">@Model.InitialFuel.ToString("0.00")</dd>

    <dt class="col-sm-3">Final Fuel</dt>
    <dd class="col-sm-9">@Model.FinalFuel.ToString("0.00")</dd>

    <dt class="col-sm-3">Consumption</dt>
    <dd class="col-sm-9">@Model.Consumption.ToString("0.00")</dd>

    <dt class="col-sm-3">Refueled</dt>
    <dd class="col-sm-9">@Model.Refueled.ToString("0.00")</dd>

    <dt class="col-sm-3">Note</dt>
    <dd class="col-sm-9">@((string.IsNullOrWhiteSpace(Model.Note) ? "-" : Model.Note))</dd>

    <dt class="col-sm-3">Created On</dt>
    <dd class="col-sm-9">@Model.CreatedOn.ToString("yyyy-MM-dd HH:mm")</dd>

    <dt class="col-sm-3">Created By</dt>
    <dd class="col-sm-9">@Model.CreatedByUserName</dd>

    <dt class="col-sm-3">Edited On</dt>
    <dd class="col-sm-9">@((Model.EditedOn?.ToString("yyyy-MM-dd HH:mm")) ?? "-")</dd>

    <dt class="col-sm-3">Edited By</dt>
    <dd class="col-sm-9">@((Model.EditedBy ?? "-"))</dd>
</dl>

<div class="mt-3 d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>

    @if (!Model.IsDeleted)
    {
        <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button class="btn btn-danger" type="submit" onclick="return confirm('Delete this entry?');">Delete</button>
        </form>
    }
    else
    {
        <form asp-action="UndoDelete" asp-route-id="@Model.Id" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button class="btn btn-warning" type="submit">Restore</button>
        </form>
    }

    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>