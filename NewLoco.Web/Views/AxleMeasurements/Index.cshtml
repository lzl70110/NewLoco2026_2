@model NewLoco.Web.ViewModels.Axles.AxleMeasurementIndexViewModel
@using NewLoco.Web.Auth
@using NewLoco.GCommon.Enums

@{
    ViewData["Title"] = "Axle Measurement Cards";
}

<h2 class="mb-4">Axle Measurement Cards</h2>

<div class="d-flex justify-content-between align-items-center mb-3">

    @if (User.HasClaim("permission", Perm.Repairs.Create))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> New Card
        </a>
    }

    <form asp-action="Index" method="get" class="d-flex gap-2">

        @Html.DropDownListFor(m => m.Filter.ShowMode,
        new SelectList(new[]
        {
                new { Value = 0, Text = "Active" },
                new { Value = 1, Text = "Deleted" },
                new { Value = 2, Text = "All" }
                }, "Value", "Text", Model.Filter.ShowMode),
                new { @class = "form-select form-select-sm", onchange = "this.form.submit()" })

    </form>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-sm-3">
        <label class="form-label mb-1">Locomotive</label>
        <input name="LocomotiveNumber" class="form-control"
               value="@Model.Filter.LocomotiveNumber" />
    </div>

    <div class="col-sm-2">
        <label class="form-label mb-1">From</label>
        <input type="date" name="From" class="form-control"
               value="@(Model.Filter.From?.ToString("yyyy-MM-dd"))" />
    </div>

    <div class="col-sm-2">
        <label class="form-label mb-1">To</label>
        <input type="date" name="To" class="form-control"
               value="@(Model.Filter.To?.ToString("yyyy-MM-dd"))" />
    </div>

    <div class="col-sm-2">
        <label class="form-label mb-1">Page size</label>
        <select name="PageSize" class="form-select">
            @foreach (var s in new[] { 10, 20, 50 })
            {
                <option value="@s" selected="@(Model.Paging.PageSize == s)">
                    @s
                </option>
            }
        </select>
    </div>

    <div class="col-sm-3 d-flex gap-2">
        <button type="submit" class="btn btn-secondary">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-bordered table-striped align-middle">
        <thead class="table-light">
            <tr>
                <th>Document</th>
                <th>Locomotive</th>
                <th>Date</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>

            @if (!Model.Items.Any())
            {
                <tr>
                    <td colspan="4" class="text-center">No records</td>
                </tr>
            }
            else
            {
                foreach (var x in Model.Items)
                {
                    var rowClass = x.IsDeleted ? "table-danger" : "";

                    <tr class="@rowClass">
                        <td>@x.DocumentNumber</td>
                        <td>@x.LocomotiveNumber</td>
                        <td>@x.MeasurementDate.ToString("dd.MM.yyyy")</td>

                        <td class="text-end">

                            <a asp-action="Details" asp-route-id="@x.Id"
                               class="btn btn-sm btn-outline-primary">
                                Details
                            </a>

                            @if (!x.IsDeleted && User.HasClaim("permission", Perm.Repairs.Edit))
                            {
                                <a asp-action="Edit" asp-route-id="@x.Id"
                                   class="btn btn-sm btn-outline-warning">
                                    Edit
                                </a>
                            }

                            @if (!x.IsDeleted && User.HasClaim("permission", Perm.Repairs.Delete))
                            {
                                <form asp-action="Delete" method="post"
                                      asp-route-id="@x.Id"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </button>
                                </form>
                            }

                            @if (x.IsDeleted && User.HasClaim("permission", Perm.Repairs.Edit))
                            {
                                <form asp-action="UndoDelete" method="post"
                                      asp-route-id="@x.Id"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-success">
                                        Restore
                                    </button>
                                </form>
                            }

                        </td>
                    </tr>
                }
            }

        </tbody>
    </table>
</div>

@if (Model.Paging.TotalPages > 1)
{
    <nav>
        <ul class="pagination pagination-sm">

            <li class="page-item @(Model.Paging.HasPrevious ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-Page="@(Model.Paging.PageNumber - 1)"
                   asp-route-PageSize="@Model.Paging.PageSize">
                    Prev
                </a>
            </li>

            @for (int p = 1; p <= Model.Paging.TotalPages; p++)
            {
                <li class="page-item @(Model.Paging.PageNumber == p ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-Page="@p"
                       asp-route-PageSize="@Model.Paging.PageSize">
                        @p
                    </a>
                </li>
            }

            <li class="page-item @(Model.Paging.HasNext ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-Page="@(Model.Paging.PageNumber + 1)"
                   asp-route-PageSize="@Model.Paging.PageSize">
                    Next
                </a>
            </li>

        </ul>
    </nav>
}