@model List<string>
@{
    ViewData["Title"] = "Locomotives";
    }

<div class="container-fluid">
    <h2 class="mb-3">Locomotives</h2>

    <div class="mt-2" style="max-width: 320px;">
        <table class="table table-sm table-striped table-hover" style="max-width: 320px; width: 60%;">
            <thead class="table-dark">
                <tr>
                    <th class="text-center" style="width: 120px;">Number</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                    {
                    foreach (var number in Model)
                        {
                        <tr>
                            <td class="text-center">@number</td>

                        </tr>
                        }
                    }
                else
                    {
                    <tr>
                        <td class="text-muted">No locomotives.</td>
                    </tr>
                    }
            </tbody>
        </table>
 
    </div>
</div>