@{
    Layout = "_ErrorLayout";
    ViewData["Title"] = "Unauthorized";
}

<div class="container d-flex flex-column justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="text-center">
        <h1 class="display-1 fw-bold text-primary">401</h1>
        <h2 class="mb-4">Unauthorized</h2>

        <p class="lead mb-4">
            You must be logged in to access this resource.<br />
            Please sign in with a valid account.
        </p>

        /
    </div>
</div>

<style>
    .display-1 {
        font-size: 8rem;
    }

    @@media (max-width: 768px) {
        .display-1

    {
        font-size: 5rem;
    }

    }
</style>