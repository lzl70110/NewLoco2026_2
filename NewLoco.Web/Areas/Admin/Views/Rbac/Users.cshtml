@model NewLoco.Web.Areas.Admin.Models.UsersWithRolesPageViewModel

@{
    ViewData["Title"] = "Users";
    Layout = "/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2 class="mt-3">Users</h2>

@if (Model == null || Model.Users == null || !Model.Users.Any())
{
    <p>No users found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>User</th>
                <th>Email</th>
                <th>Roles</th>
            </tr>
        </thead>
        <tbody>
            @* Iterate through the Users collection, not the ViewModel itself *@
            @foreach (var u in Model.Users)
            {
                <tr>
                    <td>@u.UserName</td>
                    <td>@u.Email</td>
                    <td>@string.Join(", ", u.Roles ?? Enumerable.Empty<string>())</td>
                </tr>
            }
        </tbody>
    </table>
}