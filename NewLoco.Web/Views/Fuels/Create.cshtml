@model NewLoco.Web.ViewModels.Fuels.CreateFuelViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "New Fuel Input";
}
<style>
    .create-narrow {
        max-width: 480px;
        background: #fff;
    }

        .create-narrow .form-control, .create-narrow .form-select {
            padding: 0.35rem 0.55rem;
            font-size: 0.9rem;
            line-height: 1.2;
        }

        .create-narrow .form-label {
            font-size: 0.85rem;
            margin-bottom: 2px;
        }

        .create-narrow .btn {
            padding: 0.25rem 0.6rem;
            font-size: 0.85rem;
            line-height: 1.1;
        }

        .create-narrow .mb-2 {
            margin-bottom: .4rem !important;
        }

        .create-narrow .mt-2 {
            margin-top: .4rem !important;
        }
</style>

<h2 class="h5 mb-3">@ViewData["Title"]</h2>

<div class="create-narrow mx-auto p-3 border rounded shadow-sm bg-white">

    @* TempData toasts *@
    @if (TempData["Error"] is string err && !string.IsNullOrWhiteSpace(err))
    {
        <div class="alert alert-danger py-2" role="alert">@err</div>
    }
    @if (TempData["Success"] is string ok && !string.IsNullOrWhiteSpace(ok))
    {
        <div class="alert alert-success py-2" role="alert">@ok</div>
    }

    <!-- ✅ Реален FORM таг към FuelsController.Create (POST) -->
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        @* Показваме summary само при невалиден модел *@
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>
        }

        <div class="mb-2">
            <label asp-for="LocomotiveId" class="form-label">Locomotive</label>
            @{
                var locoList = ViewBag.Locomotives as IEnumerable<SelectListItem>;
            }
            @if (locoList != null && locoList.Any())
            {
                <!-- placeholder без selected, за да не пречи на постбек -->
                <select asp-for="LocomotiveId" class="form-select" asp-items="locoList" id="LocomotiveId">
                    <option value="">-- choose --</option>
                </select>
            }
            else
            {
                <div class="alert alert-warning py-1">No locomotives to choose from.</div>
                <input asp-for="LocomotiveId" type="number" class="form-control" id="LocomotiveId" />
            }
            <span asp-validation-for="LocomotiveId" class="text-danger"></span>
        </div>

        <div class="mb-2">
            <label asp-for="Date" class="form-label"></label>
            <input asp-for="Date" type="date" class="form-control"
                   min="@DateTime.Today.AddDays(-10).ToString("yyyy-MM-dd")"
                   max="@DateTime.Today.ToString("yyyy-MM-dd")" />
            <span asp-validation-for="Date" class="text-danger"></span>
        </div>

        <div class="row g-2">
            <div class="col-6">
                <!-- скрито: стойността, която постваме -->
                <input type="hidden" asp-for="InitialFuel" id="InitialFuel" />
                <label class="form-label">Initial Fuel</label>
                <!-- само визуализация -->
                <input class="form-control" id="InitialFuelDisplay" value="@Model.InitialFuel.ToString("0.##")" readonly />
                <span asp-validation-for="InitialFuel" class="text-danger"></span>
            </div>

            <div class="col-6">
                <label asp-for="FinalFuel" class="form-label"></label>
                <!-- 10L правило е за операции, не за крайно състояние -->
                <input asp-for="FinalFuel" class="form-control" type="number" step="1" inputmode="numeric" id="FinalFuel" />
                <span asp-validation-for="FinalFuel" class="text-danger"></span>
            </div>

            <div class="col-6">
                <label asp-for="Refueled" class="form-label"></label>
                <!-- Хинт за 10L стъпка (истинската проверка е в сервиза) -->
                <input asp-for="Refueled" class="form-control" type="number" step="10" inputmode="numeric" id="Refueled" />
                <span asp-validation-for="Refueled" class="text-danger"></span>
                <div class="form-text">Depot rule: multiples of 10 L.</div>
            </div>

            <div class="col-6">
                <label class="form-label">Consumption</label>
                <input class="form-control" id="Consumption" value="0" readonly />
            </div>
        </div>

        <div class="mb-2 mt-2">
            <label asp-for="Note" class="form-label"></label>
            <textarea asp-for="Note" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Note" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2 mt-2">
            <button type="submit" class="btn btn-primary btn-sm">Save</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="text/javascript">
      

        // ---------- ES5 помощни функции ----------
        function getEl(id) { return document.getElementById(id); }
        function toNumber(val) {
            if (val === undefined || val === null) return 0;
            if (typeof val !== 'string') val = String(val);
            val = val.replace(',', '.').trim();
            var num = parseFloat(val);
            return isNaN(num) ? 0 : num;
        }

        function bothReady() {
            var locoEl = getEl('LocomotiveId');
            var dateEl = getEl('Date');
            var loco = locoEl ? locoEl.value : '';
            var date = dateEl ? dateEl.value : '';
            return !!loco && !!date;
        }

        function updateConsumption() {
            var initialEl = getEl('InitialFuel');
            var finalEl = getEl('FinalFuel');
            var refEl = getEl('Refueled');

            var initial = toNumber(initialEl ? initialEl.value : 0);
            var finalVal = toNumber(finalEl ? finalEl.value : 0);
            var refueled = toNumber(refEl ? refEl.value : 0);

            var consumption = (initial + refueled - finalVal);
            var c = getEl('Consumption');
            if (c) c.value = isFinite(consumption) ? consumption : 0;
        }

        function fetchPrevFinal() {
            if (!bothReady()) return;
            var loco = getEl('LocomotiveId').value;
            var date = getEl('Date').value;

            var xhr = new XMLHttpRequest();
            xhr.open('GET', '/Fuels/PrevFinal?locoId=' + encodeURIComponent(loco) + '&date=' + encodeURIComponent(date), true);
            xhr.onreadystatechange = function () {
                if (xhr.readyState === 4 && xhr.status === 200) {
                    try {
                        var data = JSON.parse(xhr.responseText);
                        var v = Number((data && data.value) ? data.value : 0);
                        var initHidden = getEl('InitialFuel');
                        var initDisplay = getEl('InitialFuelDisplay');
                        if (initHidden) initHidden.value = v;
                        if (initDisplay) initDisplay.value = Math.round(v).toString();
                        updateConsumption();
                    } catch (e) { /* ignore */ }
                }
            };
            xhr.send();
        }

        document.addEventListener('DOMContentLoaded', function () {
            var locoEl = getEl('LocomotiveId');
            var dateEl = getEl('Date');
            var finalEl = getEl('FinalFuel');
            var refEl = getEl('Refueled');

            if (locoEl) locoEl.addEventListener('change', fetchPrevFinal);
            if (dateEl) dateEl.addEventListener('change', fetchPrevFinal);
            if (finalEl) finalEl.addEventListener('input', updateConsumption);
            if (refEl) refEl.addEventListener('input', updateConsumption);

            if (bothReady()) fetchPrevFinal();
            updateConsumption();
        });
    </script>
}