@model List<NewLoco.Web.ViewModels.Locomotives.LocomotiveNumberViewModel>

<h2 class="h4 mb-3">Our Locomotives</h2>

<table class="table table-sm table-striped table-hover align-middle w-auto">
    <thead class="table-light">
        <tr>
            <th>#</th>
            <th>Type</th>
            <th>Unit</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var l in Model)
            {
            <tr class="@(l.IsDeleted ? "table-secondary" : "")">
                <td class="text-nowrap">@l.Number</td>
                <td>@l.LocomotiveType</td>
                <td>@l.MeasuringUnit</td>
            </tr>
            }
    </tbody>
</table>