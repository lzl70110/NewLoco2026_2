@model NewLoco.Web.ViewModels.Fuels.FuelAllViewModel

@{
    ViewData["Title"] = "Edit Fuel Record";
}

<h2 class="h5 mb-3">@ViewData["Title"]</h2>

<div class="edit-narrow mx-auto p-3 border rounded shadow-sm bg-white">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="InitialFuel" id="InitialFuel" />
        <input type="hidden" asp-for="LocomotiveNumber" />

        <div class="mb-2">
            <label class="form-label">Locomotive</label>
            <input class="form-control" value="@Model.LocomotiveNumber" readonly />
        </div>

        <div class="mb-2">
            <label asp-for="Date" class="form-label"></label>
            <input asp-for="Date" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
            <span asp-validation-for="Date" class="text-danger"></span>
        </div>

        <div class="row g-2">
            <div class="col-6">
                <label class="form-label">Initial Fuel</label>
                <input class="form-control" value="@Model.InitialFuel.ToString("0.##")" readonly />
                <span asp-validation-for="InitialFuel" class="text-danger"></span>
            </div>

            <div class="col-6">
                <label asp-for="FinalFuel" class="form-label"></label>
                <input asp-for="FinalFuel" class="form-control" type="number" step="0.01" inputmode="decimal" id="FinalFuel" />
                <span asp-validation-for="FinalFuel" class="text-danger"></span>
            </div>

            <div class="col-6">
                <label asp-for="Refueled" class="form-label"></label>
                <input asp-for="Refueled" class="form-control" type="number" step="0.01" inputmode="decimal" id="Refueled" />
                <span asp-validation-for="Refueled" class="text-danger"></span>
            </div>

            <div class="col-6">
                <label class="form-label">Consumption</label>
                <input class="form-control" id="Consumption" value="@Model.Consumption.ToString("0.##")" readonly />
            </div>
        </div>

        <div class="mb-2 mt-2">
            <label asp-for="Note" class="form-label"></label>
            <textarea asp-for="Note" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Note" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2 mt-2">
            <button type="submit" class="btn btn-primary btn-sm">Save</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancel</a>
        </div>
    </form>
</div>

@section Styles {
    <style>
        .edit-narrow {
            max-width: 480px;
            background: #ffffff;
        }

            .edit-narrow .form-control {
                padding: 0.35rem 0.55rem;
                font-size: 0.9rem;
                line-height: 1.2;
            }

            .edit-narrow .form-label {
                font-size: 0.85rem;
                margin-bottom: 2px;
            }

            .edit-narrow .btn {
                padding: 0.25rem 0.6rem;
                font-size: 0.85rem;
                line-height: 1.1;
            }

            .edit-narrow .mb-2 {
                margin-bottom: .4rem !important;
            }

            .edit-narrow .mt-2 {
                margin-top: .4rem !important;
            }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function n(v){if(v===undefined||v===null)return 0;if(typeof v!=='string')v=String(v);v=v.replace(',','.').trim();var x=parseFloat(v);return isNaN(x)?0:x;}
        function upd(){
            var init = n(document.getElementById('InitialFuel')?.value);
            var fin  = n(document.getElementById('FinalFuel')?.value);
            var ref  = n(document.getElementById('Refueled')?.value);
            var c = document.getElementById('Consumption');
            if(c) c.value = (init + ref - fin).toFixed(2);
        }
        document.addEventListener('DOMContentLoaded', function () {
            ['FinalFuel','Refueled'].forEach(id=>{
                var el=document.getElementById(id);
                if(el) el.addEventListener('input', upd);
            });
            upd();
        });
    </script>
}