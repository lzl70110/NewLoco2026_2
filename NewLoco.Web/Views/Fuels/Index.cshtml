@model IEnumerable<NewLoco.Web.ViewModels.Fuels.FuelsBasicDetailsViewModel>

@{
    ViewData["Title"] = "Fuel Records";
}

<h2 class="h5 mb-3">@ViewData["Title"]</h2>

<div class="d-flex justify-content-between align-items-center mb-2">
    <a asp-action="Create" class="btn btn-success btn-sm">Add New Fuel Record</a>
</div>

<div class="table-responsive">
    <table class="table table-sm table-striped table-bordered align-middle compact-columns">
        <thead class="table-dark">
            <tr>
                <th class="text-nowrap">Locomotive</th>
                <th class="text-nowrap">Date</th>
                <th class="text-end text-nowrap">Initial</th>
                <th class="text-end text-nowrap">Final</th>
                <th class="text-center text-nowrap actions-col">Details</th>
            </tr>
        </thead>

        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-3">No records</td>
                </tr>
            }
            else
            {
                foreach (var x in Model)
                {
                    var rowClass = x.IsDeleted ? "table-danger" : "";

                    <tr class="@rowClass">

                        <td class="text-nowrap">
                            <a asp-area="Admin"
                               asp-controller="Locomotives"
                               asp-action="Details"
                               asp-route-id="@x.LocomotiveId"
                               class="text-decoration-none">@x.LocomotiveNumber</a>
                        </td>

                        <td class="text-nowrap">@x.Date.ToString("yyyy-MM-dd")</td>

                        <td class="text-end text-nowrap">@x.InitialFuel.ToString("0.00")</td>

                        <td class="text-end text-nowrap">@x.FinalFuel.ToString("0.00")</td>

                        <td class="text-center actions-col">
                            <a asp-action="Details" asp-route-id="@x.Id"
                               class="btn btn-outline-secondary btn-sm">Details</a>
                        </td>

                    </tr>
                }
            }
        </tbody>
    </table>
</div>

 
@section Styles {
<style>
    /* shrink table columns horizontally without touching font-size */
    .fuel-table td,
    .fuel-table th {
        padding: 0.35rem 0.50rem !important;   /* smaller horizontal padding */
        white-space: nowrap !important;        /* keep text on one line */
        text-overflow: ellipsis;
        overflow: hidden;
    }

    /* narrowest columns */
    .fuel-col-loco   { max-width: 70px !important; }
    .fuel-col-date   { max-width:  65px !important; }
    .fuel-col-num    { max-width: 40px !important; text-align:right; }
    .fuel-col-actions{ width: 40px !important; text-align:center; }
</style>
}