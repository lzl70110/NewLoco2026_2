@model NewLoco.Web.ViewModels.ShiftWorks.CreateShiftWorkViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using NewLoco.GCommon.Enums
@{
    ViewData["Title"] = "Create New Shift";
    }

<h2 class="h5 mb-3">@ViewData["Title"]</h2>

@if (TempData["Error"] is string e && !string.IsNullOrWhiteSpace(e))
    {
    <div class="alert alert-danger py-2">@e</div>
    }

<div class="mx-auto p-3 border rounded shadow-sm bg-white" style="max-width:520px;">
    <form asp-action="Create" method="post" novalidate>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <!-- Locomotive dropdown -->
        <div class="mb-2">
            <label asp-for="LocomotiveId" class="form-label">Locomotive</label>
            <select asp-for="LocomotiveId" class="form-select" asp-items="Model.Locomotives">
                <option value="" disabled selected>-- choose --</option>
            </select>
            <span asp-validation-for="LocomotiveId" class="text-danger"></span>
        </div>

        <!-- Date -->
        <div class="mb-2">
            <label asp-for="Date" class="form-label">Date</label>
            <input asp-for="Date" class="form-control" type="date" asp-format="{0:yyyy-MM-dd}" />
            <span asp-validation-for="Date" class="text-danger"></span>
        </div>

        <!-- Shift -->
        <div class="mb-2">
            <label asp-for="Shift" class="form-label">Shift</label>
            <select asp-for="Shift" class="form-select">
                @foreach (var s in Enum.GetValues(typeof(Shift)))
                    {
                    <option value="@((int)s)" selected="@(Model.Shift.Equals(s) ? "selected" : null)">@s</option>
                    }
            </select>
            <span asp-validation-for="Shift" class="text-danger"></span>
        </div>

        <!-- Initial Value (readonly) -->
        <div class="mb-2">
            <label class="form-label">Initial Value</label>
            @if (Model.InitialValueDate.HasValue)
                {
                <div class="small text-muted mb-1">
                    Taken from last shift on @Model.InitialValueDate.Value.ToString("dd.MM.yyyy")
                </div>
                }


            <input asp-for="InitialValue" class="form-control" readonly id="InitialValue" />
        </div>

        <!-- Final Value (editable) -->
        <div class="mb-2">
            <label asp-for="FinalValue" class="form-label">Final Value</label>
            <input asp-for="FinalValue" class="form-control" type="number" step="0.01" inputmode="decimal" id="FinalValue" />
            <span asp-validation-for="FinalValue" class="text-danger"></span>
        </div>

        <!-- Total Value (calculated) -->
        <div class="mb-2">
            <label class="form-label">Total Value</label>
            <input class="form-control" id="TotalValue" readonly />
        </div>

        <!-- Note -->
        <div class="mb-2">
            <label asp-for="Note" class="form-label">Note</label>
            <textarea asp-for="Note" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Note" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2 mt-2">
            <button type="submit" class="btn btn-primary btn-sm">Save</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancel</a>
        </div>
    </form>
</div>

    @section Scripts {
    <partial name="~/Areas/Identity/Pages/_ValidationScriptsPartial.cshtml" />
    <script>
        function toNumber(v) {
            if (v === undefined || v === null) return 0;
            if (typeof v !== 'string') v = String(v);
            v = v.replace(',', '.').trim();
            var n = parseFloat(v);
            return isNaN(n) ? 0 : n;
        }

        function updateTotal() {
            var init = toNumber(document.getElementById('InitialValue')?.value);
            var fin = toNumber(document.getElementById('FinalValue')?.value);
            document.getElementById('TotalValue').value = (fin - init).toFixed(2);
        }

        document.addEventListener('DOMContentLoaded', function () {
            var f = document.getElementById('FinalValue');
            if (f) f.addEventListener('input', updateTotal);
            updateTotal();
        });
    </script>
    }
