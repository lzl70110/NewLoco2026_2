@model NewLoco.Web.ViewModels.Fuels.CreateFuelViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "New Fuel Input";
    }
<style>
    .create-narrow {
        max-width: 480px;
        background: #fff;
    }

        .create-narrow .form-control, .create-narrow .form-select {
            padding: 0.35rem 0.55rem;
            font-size: 0.9rem;
            line-height: 1.2;
        }

        .create-narrow .form-label {
            font-size: 0.85rem;
            margin-bottom: 2px;
        }

        .create-narrow .btn {
            padding: 0.25rem 0.6rem;
            font-size: 0.85rem;
            line-height: 1.1;
        }

        .create-narrow .mb-2 {
            margin-bottom: .4rem !important;
        }

        .create-narrow .mt-2 {
            margin-top: .4rem !important;
        }
</style>

<h2 class="h5 mb-3">@ViewData["Title"]</h2>

<div class="create-narrow mx-auto p-3 border rounded shadow-sm bg-white">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-2">
            <label asp-for="LocomotiveId" class="form-label">Locomotive</label>
                @{
                var locoList = ViewBag.Locomotives as IEnumerable<SelectListItem>;
                }
            @if (locoList != null && locoList.Any())
                {
                <select asp-for="LocomotiveId" class="form-select" asp-items="locoList" id="LocomotiveId">
                    <option value="" disabled selected>-- choose --</option>
                </select>
                }
            else
                {
                <div class="alert alert-warning py-1">No locomotives to choose from.</div>
                <input asp-for="LocomotiveId" type="number" class="form-control" id="LocomotiveId" />
                }
            <span asp-validation-for="LocomotiveId" class="text-danger"></span>
        </div>

        <div class="mb-2">
            <label asp-for="Date" class="form-label"></label>
            <input asp-for="Date" class="form-control" type="date" asp-format="{0:yyyy-MM-dd}" id="Date" />
            <span asp-validation-for="Date" class="text-danger"></span>
        </div>

        <input type="hidden" name="__Invariant" value="Date,FinalFuel,Refueled,InitialFuel" />

        <div class="row g-2">
            <div class="col-6">
                <input type="hidden" asp-for="InitialFuel" id="InitialFuel" />
                <label class="form-label">Initial Fuel</label>
                <input class="form-control" id="InitialFuelDisplay" value="@Model.InitialFuel.ToString("0.##")" readonly />
                <span asp-validation-for="InitialFuel" class="text-danger"></span>
            </div>

            <div class="col-6">
                <label asp-for="FinalFuel" class="form-label"></label>
                <input asp-for="FinalFuel" class="form-control" type="number" step="0.01" inputmode="decimal" id="FinalFuel" />
                <span asp-validation-for="FinalFuel" class="text-danger"></span>
            </div>

            <div class="col-6">
                <label asp-for="Refueled" class="form-label"></label>
                <input asp-for="Refueled" class="form-control" type="number" step="0.01" inputmode="decimal" id="Refueled" />
                <span asp-validation-for="Refueled" class="text-danger"></span>
            </div>

            <div class="col-6">
                <label class="form-label">Consumption</label>
                <input class="form-control" id="Consumption" value="0.00" readonly />
            </div>
        </div>

        <div class="mb-2 mt-2">
            <label asp-for="Note" class="form-label"></label>
            <textarea asp-for="Note" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Note" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2 mt-2">
            <button type="submit" class="btn btn-primary btn-sm">Save</button>
            <a asp-action="FuelReport" class="btn btn-outline-secondary btn-sm">Cancel</a>
        </div>
    </form>
</div>

    @section Scripts {
    <script>
        function toNumber(val){ if(val===undefined||val===null) return 0; if(typeof val!=='string') val=String(val); val=val.replace(',', '.').trim(); var num=parseFloat(val); return isNaN(num)?0:num; }
        function fmt(x){ return (Math.round(x*100)/100).toFixed(2); }
        function fmtBg(x){ return fmt(x).replace('.', ','); }
        function bothReady(){ var loco=document.getElementById('LocomotiveId')?.value; var date=document.getElementById('Date')?.value; return loco && date; }

        async function fetchPrevFinal(){
            if(!bothReady()) return;
            var loco=document.getElementById('LocomotiveId').value;
            var date=document.getElementById('Date').value;
            try{
                const r=await fetch(`/Fuels/PrevFinal?locoId=${encodeURIComponent(loco)}&date=${encodeURIComponent(date)}`);
                if(!r.ok) return;
                const data=await r.json();
                var v=Number(data.value||0);
                document.getElementById('InitialFuel').value=fmt(v);
                document.getElementById('InitialFuelDisplay').value=fmtBg(v);
                updateConsumption();
            }catch(e){}
        }

        function updateConsumption(){
            var initial=toNumber(document.getElementById('InitialFuel')?.value);
            var finalVal=toNumber(document.getElementById('FinalFuel')?.value);
            var refueled=toNumber(document.getElementById('Refueled')?.value);
            var consumption=(initial+refueled-finalVal);
            var c=document.getElementById('Consumption');
            if(c) c.value=fmt(consumption);
        }

        document.addEventListener('DOMContentLoaded', function(){
            var locoEl=document.getElementById('LocomotiveId');
            var dateEl=document.getElementById('Date');
            if(locoEl) locoEl.addEventListener('change', fetchPrevFinal);
            if(dateEl) dateEl.addEventListener('change', fetchPrevFinal);
            var finEl=document.getElementById('FinalFuel');
            var refEl=document.getElementById('Refueled');
            if(finEl) finEl.addEventListener('input', updateConsumption);
            if(refEl) refEl.addEventListener('input', updateConsumption);
            if(bothReady()) fetchPrevFinal();
            updateConsumption();
        });
    </script>
    }