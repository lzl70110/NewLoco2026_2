@model List<NewLoco.Web.ViewModels.Fuels.FuelAllViewModel>
@{
    ViewData["Title"] = "Fuel Records";
    }

<h2>@ViewData["Title"]</h2>

<a asp-action="Create" class="btn btn-success mb-3">Add New Fuel Record</a>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Locomotive</th>
            <th>Date</th>
            <th>Initial Fuel</th>
            <th>Final Fuel</th>
            <th>Consumption</th>
            <th>Refueled</th>
            <th>Note</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var fuel in Model)
            {
            var rowClass = fuel.IsDeleted ? "table-danger" : "";
            <tr class="@rowClass">
                <td>@fuel.LocomotiveNumber</td>
                <td>@fuel.Date.ToString("dd.MM.yyyy")</td>
                <td>@fuel.InitialFuel</td>
                <td>@fuel.FinalFuel</td>
                <td>@fuel.Consumption</td>
                <td>@fuel.Refueled</td>
                <td>@fuel.Note</td>
                <td>
                    @if (!fuel.IsDeleted)
                        {
                        <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@fuel.Id">Edit</a>
                        <form asp-action="DeleteConfirmed" asp-route-id="@fuel.Id" method="post" style="display:inline">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-danger" type="submit">Delete</button>
                        </form>
                        }
                    else
                        {
                        <form asp-action="UndoDelete" asp-route-id="@fuel.Id" method="post" style="display:inline">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-success" type="submit">Undo</button>
                        </form>
                        }
                </td>
            </tr>
            }
    </tbody>
</table>

<a asp-controller="Home" asp-action="Index" class="btn btn-secondary mt-3">Back to Home</a>
