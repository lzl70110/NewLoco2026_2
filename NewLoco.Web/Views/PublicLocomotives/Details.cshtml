@model NewLoco.Web.ViewModels.Locomotives.LocomotiveDetailsViewModel

<h2 class="h5 mb-3">Locomotive Details</h2>

<table class="table table-sm table-bordered w-auto">
    <tr><th>Number</th><td>@Model.Number</td></tr>
    <tr><th>Type</th><td>@Model.LocomotiveType</td></tr>
    <tr><th>Unit</th><td>@Model.MeasuringUnit</td></tr>
    <tr><th>Note</th><td>@Model.Note</td></tr>
    <tr><th>Created</th><td>@Model.CreatedOn!.ToString("yyyy-MM-dd") by @Model.CreatedBy</td></tr>
    <tr><th>Edited</th><td>@Model.ModifiedOn?.ToString("yyyy-MM-dd") by @Model.ModifiedBy</td></tr>
</table>